# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite default for zero-friction setup, supports PostgreSQL/MySQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication
# IMPORTANT: Use a strong, random secret key in production (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting for Auth Endpoints
# Window size in milliseconds (e.g., 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum attempts per IP per window
RATE_LIMIT_MAX_ATTEMPTS=5

# External API Integration (Example: Exchange Rates API or Weather API)
# API key must NEVER be hardcoded in application source code
EXTERNAL_API_KEY=your_external_api_key_here
EXTERNAL_API_URL=https://v6.exchangerate-api.com/v6
